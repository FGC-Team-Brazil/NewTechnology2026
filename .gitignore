planilha_fogos_consolidados.csv
enriched_hotspots.csv

# === Dados diários do scraper ===
focos_diarios/

# === Outputs gerados (dashboards, recomendações, JSONs) ===
outputs/
saidas/
geodataoutputs/

# === Machine Learning — dados de treino e modelos ===
ml/datasets/*.jsonl
ml/datasets/*.csv
ml/models/
*.pkl
*.joblib

# === Jupyter ===
.ipynb_checkpoints/

# === IDEs e editores ===
.vscode/
.idea/
*.swp
*.swo

# === Sistema operacional ===
.DS_Store
Thumbs.db