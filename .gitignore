# === Python ===
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# === Ambientes virtuais ===
.venv/
venv/
env/
.env

# === Banco de dados local ===
*.db
*.sqlite3
dados_locais/
data/local/

# === Dados brutos (grandes) ===
